{
  "method": "absolute_gt_h2_normalized_laplacian_with_confidence",
  "seed": 7,
  "device": "cuda",
  "dataset": {
    "name": "Sofa50",
    "expected_split_counts": {
      "train": 40,
      "validation": 5,
      "test": 5
    }
  },
  "input_mode": "coarse_plus_multiview",
  "target_mode": "edge_scale_normalized_laplacian",
  "target_semantics": "absolute_gt_target_not_residual",
  "target_scaling": {
    "method": "square_of_mean_incident_edge_length",
    "epsilon": 1e-12,
    "clip_max_norm": null
  },
  "query_training": {
    "enabled": true,
    "exact_fraction": 0.2,
    "normal_std_h": 0.0003,
    "tangent_std_h": 0.0003,
    "max_offset_h": 0.001,
    "apply_to_validation": true,
    "zero_initial_laplacian": true
  },
  "renderer_visibility": {
    "condition": "backface_and_occlusion",
    "source": "precomputed_depth_tested_face_id_buffer",
    "neighborhood_radius": 1,
    "front_face_winding": "ccw",
    "depth_image_used": false
  },
  "image_encoder": {
    "feature_dim": 16,
    "normalization": {
      "mean": [0.0, 0.0, 0.0],
      "std": [1.0, 1.0, 1.0]
    }
  },
  "model": {
    "hidden_dim": 64,
    "num_graph_layers": 3,
    "dropout": 0.0,
    "geometry_mode": "query_fourier",
    "position_encoding": {
      "num_frequencies": 6,
      "include_input": true
    }
  },
  "confidence": {
    "enabled": true,
    "loss_weight": 1.0,
    "regularizer": 0.01,
    "minimum_confidence": 0.0001,
    "quantile_bins": 5,
    "recovery_weight": "renderer_visible_any_times_confidence_prediction"
  },
  "training": {
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "loss": "huber",
    "huber_delta": 0.01,
    "gradient_clip_norm": 1.0,
    "amp": {
      "enabled": true,
      "dtype": "float16"
    },
    "lr_scheduler": {
      "type": "reduce_on_plateau",
      "factor": 0.5,
      "patience_validations": 10,
      "threshold": 0.0001,
      "threshold_mode": "abs",
      "cooldown_validations": 1,
      "min_lr": 0.000001
    }
  },
  "data_loading": {
    "num_workers": 4,
    "pin_memory": true,
    "persistent_workers": true,
    "prefetch_factor": 2,
    "train_views_per_sample": null,
    "validation_views_per_sample": null
  },
  "multi_object_training": {
    "epochs": 2000,
    "max_optimizer_steps": 20000,
    "gradient_accumulation_meshes": 4,
    "shuffle": true,
    "validation_every_epochs": 5,
    "checkpoint_every_epochs": 100,
    "checkpoint_epochs": [100, 250, 500, 1000, 1500, 2000],
    "cache_prepared_samples_on_device": false,
    "profile_training": true,
    "early_stopping": {
      "enabled": false,
      "patience_validations": 15,
      "min_delta": 0.0001
    }
  },
  "recovery": {
    "operator_type": "uniform",
    "lambda_lap": 1.0,
    "lambda_anchor": 0.01,
    "lambda_edge": 0.0,
    "num_iters": 200,
    "learning_rate": 0.01,
    "robust_loss": "huber",
    "huber_delta": 0.01,
    "unseen_anchor_weight": 0.0,
    "write_legacy_prediction_names": false,
    "denormalization": "delta_pred_raw=delta_hat_prediction*(h_current^2+1e-12)"
  }
}
