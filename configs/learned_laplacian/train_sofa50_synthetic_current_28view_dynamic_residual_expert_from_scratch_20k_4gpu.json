{
  "method": "synthetic_current_28view_dynamic_residual_expert_from_scratch",
  "seed": 7,
  "device": "cuda",
  "dataset": {
    "name": "Sofa50SyntheticCurrent28View",
    "expected_split_counts": {"train": 200, "validation": 25, "test": 25},
    "objects": 50,
    "variants_per_object": 5,
    "object_level_split": true
  },
  "input_mode": "coarse_plus_multiview",
  "target_mode": "raw_laplacian",
  "target_semantics": "current_graph_proxy_target",
  "target_definition": "delta_target_raw=L_current@P_proxy",
  "target_scaling": {
    "method": "square_of_mean_incident_edge_length",
    "source": "synthetic_current_graph",
    "epsilon": 1e-12,
    "clip_max_norm": null
  },
  "query_training": {
    "enabled": false,
    "exact_fraction": 0.2,
    "normal_std_h": 0.0003,
    "tangent_std_h": 0.0003,
    "max_offset_h": 0.001,
    "apply_to_validation": false,
    "zero_initial_laplacian": false
  },
  "local_query_jitter": {
    "enabled": false,
    "std_h": 0.003,
    "distribution": "isotropic_gaussian_xyz_clipped_at_3sigma",
    "maximum_offset_h": 0.009,
    "scope": "training_only",
    "frozen": ["proxy", "target", "h_current", "graph", "connectivity", "operator"]
  },
  "renderer_visibility": {
    "condition": "backface_and_occlusion",
    "source": "precomputed_current_graph_depth_tested_face_id_buffer",
    "neighborhood_radius": 1,
    "front_face_winding": "ccw",
    "depth_image_used": false
  },
  "image_encoder": {
    "feature_dim": 64,
    "first_stride": 1,
    "second_stride": 1,
    "normalization": {"mean": [0.0, 0.0, 0.0], "std": [1.0, 1.0, 1.0]}
  },
  "model": {
    "hidden_dim": 256,
    "num_graph_layers": 3,
    "dropout": 0.0,
    "geometry_mode": "query_fourier",
    "position_encoding": {"num_frequencies": 6, "include_input": true},
    "dynamic_residual_expert": {
      "enabled": true,
      "residual_hidden_dim": 32,
      "gate_hidden_dim": 32,
      "gate_activation": "relu_tanh_signed",
      "gate_formula": "g=max(0,tanh(a))",
      "gate_initial_bias": 0.1,
      "gate_final_weight_initialization": "zeros",
      "residual_output_initialization": "zeros",
      "input": "existing_shared_per_vertex_graph_representation_only"
    }
  },
  "confidence": {
    "enabled": true,
    "loss_weight": 1.0,
    "regularizer": 0.01,
    "minimum_confidence": 0.0001,
    "quantile_bins": 5,
    "recovery_weight": "renderer_visible_any_times_confidence_prediction"
  },
  "training": {
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "loss": "mse",
    "huber_delta": 0.01,
    "prediction_loss_space": "output_representation",
    "trainable_parameter_scope": "all",
    "gradient_clip_norm": 1.0,
    "vertex_sampling": {"mode": "full"},
    "amp": {"enabled": true, "dtype": "float16"},
    "lr_scheduler": {
      "type": "reduce_on_plateau",
      "factor": 0.5,
      "patience_validations": 10,
      "threshold": 0.0001,
      "threshold_mode": "abs",
      "cooldown_validations": 1,
      "min_lr": 0.000001
    }
  },
  "data_loading": {
    "num_workers": 0,
    "pin_memory": true,
    "persistent_workers": false,
    "prefetch_factor": 2,
    "multiprocessing_sharing_strategy": "file_system",
    "cuda_prefetch": true,
    "train_views_per_sample": null,
    "validation_views_per_sample": null
  },
  "multi_object_training": {
    "epochs": 2000,
    "max_optimizer_steps": 20000,
    "gradient_accumulation_meshes": 2,
    "report_every_optimizer_steps": 200,
    "shuffle": true,
    "validation_every_epochs": 20,
    "checkpoint_every_epochs": 400,
    "checkpoint_optimizer_steps": [0, 10000, 20000],
    "cache_prepared_samples_on_device": false,
    "profile_training": true,
    "early_stopping": {"enabled": false, "patience_validations": 15, "min_delta": 0.0001}
  },
  "recovery": {
    "operator_type": "uniform",
    "lambda_lap": 1.0,
    "lambda_anchor": 0.01,
    "lambda_edge": 0.0,
    "num_iters": 200,
    "learning_rate": 0.01,
    "robust_loss": "huber",
    "huber_delta": 0.01,
    "unseen_anchor_weight": 0.0,
    "write_legacy_prediction_names": false,
    "denormalization": "none; model output is delta_pred_raw"
  },
  "experiment_metadata": {
    "experiment": "joint_from_scratch_mse_base_learned_dynamic_residual_expert",
    "arm": "joint_base_plus_dynamic_residual_expert_from_scratch",
    "capacity": "C2",
    "feature_resolution": "F2",
    "views": 28,
    "input_resolution": 960,
    "initialization": "random_seed_7_no_checkpoint",
    "trainable_scope": "base_gate_residual_and_confidence_jointly",
    "routing_supervision": "none",
    "forbidden_gate_inputs": ["gt", "gt_magnitude", "gt_curvature", "gt_residual", "downstream_metrics"],
    "distributed_world_size": 4,
    "per_rank_batch_meshes": 1,
    "gradient_accumulation_meshes": 2,
    "global_batch_meshes": 8,
    "mse_baseline_global_batch_meshes": 6,
    "authorized_batch_difference": true
  }
}
