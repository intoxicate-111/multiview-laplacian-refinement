# Data directories
.hpc.local.md
inputs/
inputs_sphere/
inputs_sphere_smoke/

# Generated experiment outputs. Mesh OBJ artifacts are intentionally allowed
# so coarse/refined surfaces can be versioned without logs, images, depth maps,
# dense point clouds, or optimizer traces.
runs/**
!runs/**/
!runs/**/*.obj

# Generated reports and benchmark exports stay local. Some reports contain
# large tables and visualizations that should not be committed or pushed.
reports/

# Local high-volume training trials are generated artifacts, including OBJ
# visualizations that are otherwise allowed by the generic runs rule above.
runs/thingi10k50_gpu_trial/

# Learned single-object runs include checkpoints and diagnostic meshes; keep
# them local even though other run OBJ artifacts may be versioned.
runs/learned_laplacian/**
boundary_diagnostic/
projected_gt_on_coarse.obj
.external/
mesh/input.obj
mesh/test1.obj
